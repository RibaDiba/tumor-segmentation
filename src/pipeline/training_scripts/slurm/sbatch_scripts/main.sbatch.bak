#!/bin/bash

#SBATCH --job-name=test-path-rgb-1
#SBATCH --partition=pli 
#SBATCH --account=puchalla
SBATCH --qos=gpu-short
#SBATCH --nodes=1 
#SBATCH --ntasks=1 
#SBATCH --cpus-per-task=4
#SBATCH --mem=40G 
#SBATCH --time=01:00:00
#SBATCH --gres=gpu:1 

#SBATCH --output=logs/test-path-rgb-1/%x.%j.out   # STDOUT → logs/test-path-rgb-1/<jobid>.out
#SBATCH --error=logs/test-path-rgb-1/%x.%j.err    # STDERR → logs/test-path-rgb-1/<jobid>.err

# config: 
NAME="test-path-rgb-1"
ITER=5000

# create a logs dir 
mkdir -p logs/${NAME}

../../train.sh --name ${NAME} --iter ${ITER} --root-path ../../ --rgb true --split-cashe false --skip-tests true
